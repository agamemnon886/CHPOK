                         POK_NEEDS_ARINC653_PARTITION \
                         POK_NEEDS_ARINC653_PROCESS \
                         POK_NEEDS_ARINC653_QUEUEING \
                         POK_NEEDS_ARINC653_SAMPLING \
                         POK_NEEDS_ARINC653_SEMAPHORE \
                         POK_NEEDS_ARINC653_TIME \
                         POK_NEEDS_BLACKBOARDS \
                         POK_NEEDS_BUFFERS \
