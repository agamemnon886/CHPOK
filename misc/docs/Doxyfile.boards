#
# The configuration of docs/boards.pdf, the documentation of the functions and
# types of the board support packages (boards/), built by `make docs` or `make
# docs-boards`. The shared settings are in misc/docs/Doxyfile.common, which also
# explains the input.

@INCLUDE               = misc/docs/Doxyfile.common

PROJECT_NAME           = "JetOS boards"
PROJECT_BRIEF          = "Functions and data types"
OUTPUT_DIRECTORY       = build/docs/boards
WARN_LOGFILE           = build/docs/boards/warnings.log

# The C files and headers of boards/, and the groups of the types and
# macros.
INPUT                  = boards misc/docs/groups.dox
