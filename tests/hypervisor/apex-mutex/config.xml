<Hypervisor>
    <Console Port="COM1"/>

    <VM Name="apex" Memory="64MiB"
        Image="../../apex/build/{bsp}/pok.elf">
        <Console Port="COM2"/>
    </VM>

    <VM Name="mutex" Memory="64MiB"
        Image="../../mutex/build/{bsp}/pok.elf">
        <Console Port="COM3"/>
    </VM>
</Hypervisor>
