<chpok-configuration xmlns:xi="http://www.w3.org/2001/XInclude">
    <Partitions>
        <xi:include href="P1/config.xml" parse="xml"/>
        <xi:include href="P2/config.xml" parse="xml"/>
    </Partitions>

    <Schedule>
        <Slot Type="Partition" PartitionNameRef="P1" Duration="20ms" PeriodicProcessingStart="true" />
        <Slot Type="Partition" PartitionNameRef="P2" Duration="20ms" PeriodicProcessingStart="true" />
        <Slot Type="GDB" Duration="10ms" />
    </Schedule>
</chpok-configuration>
