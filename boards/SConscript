Import('env')

bsp_env = env.Clone()
bsp_env.Append(CPPPATH = bsp_env['KERNEL_CPPPATH'])
# Board code is part of the kernel, so it must obey the same restrictions
# (no FP/SIMD registers, see CFLAGS_KERNEL in misc/SConscript).
bsp_env.Append(CFLAGS = ' ' + bsp_env['CFLAGS_KERNEL'])

bsp_env.Program(target = 'bsp.lo', source = Glob(bsp_env['BSP']+'/*.[Sc]'))

