# Builds the library that the kernel and the hypervisor share (common/)
# for the kernel: common.lo, which misc/SConscript_base links into the
# kernel with the kernel's own objects. The files are compiled as kernel
# code: with the kernel's headers, its compiler flags and -Werror.

Import('env')

common_env = env.Clone()
common_env.Append(CFLAGS = ' -Werror')

if 'CFLAGS_KERNEL' in common_env:
    common_env.Append(CFLAGS = ' ' + common_env['CFLAGS_KERNEL'])

common_env['CPPPATH'] = common_env['KERNEL_CPPPATH']

common_env.Program(target = 'common.lo', source = Glob('*.c'))
